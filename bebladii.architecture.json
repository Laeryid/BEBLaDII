        [870, 450],
        [1070, 450]
      ],
      "labelAt": [970, 460]
    },
    {
      "from": "faiss_index",
      "to": "clm",
      "label": "Retrieved + Relevance Gate eval",
      "variant": "dashed",
      "via": [
        [1070, 315],
        [870, 315]
      ],
      "labelAt": [970, 325]
    },
    {
      "from": "clm",
      "to": "latent_bert",
      "label": "Inject via CA_Memory",
      "labelAt": [800, 356]
    }
